# VeriPay Loop — Backend Environment Variables
# Copy this file to .env and fill in real values.

PORT=3001

# Arc Testnet RPC (or http://127.0.0.1:8545 for local Anvil)
ARC_RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002

# Operator wallet private key (deployer wallet with testnet funds)
OPERATOR_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# Contract addresses (written by deploy script)
USAGE_METER_ADDRESS=0x_YOUR_CONTRACT_ADDRESS
NANO_SETTLEMENT_ADDRESS=0x_YOUR_CONTRACT_ADDRESS
AGENT_REGISTRY_ADDRESS=0x_YOUR_CONTRACT_ADDRESS
USDC_ADDRESS=0x_YOUR_CONTRACT_ADDRESS
