# VeriPay Loop — Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# The deploy scripts (demo-deploy.sh / deploy-arc-testnet.js) write this automatically.

NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_USAGE_METER_ADDRESS=0x_YOUR_CONTRACT_ADDRESS
NEXT_PUBLIC_NANO_SETTLEMENT_ADDRESS=0x_YOUR_CONTRACT_ADDRESS
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=0x_YOUR_CONTRACT_ADDRESS
NEXT_PUBLIC_USDC_ADDRESS=0x_YOUR_CONTRACT_ADDRESS
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
