# VeriPay Provider Agent — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it contains your private key.

# ── Arc Testnet ──────────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002

# ── VeriPay backend ──────────────────────────────────────
VERIPAY_BACKEND_URL=http://localhost:3001

# ── Provider agent config ────────────────────────────────
PROVIDER_AGENT_PORT=4101
PROVIDER_AGENT_ID=provider-risk-agent
PROVIDER_AGENT_NAME=Risk Analysis Provider
PROVIDER_AGENT_PRICE_USDC=0.001

# ── Provider wallet (REQUIRED) ───────────────────────────
# Generate a new wallet:  node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# Fund it from Arc faucet: https://faucet.circle.com
PROVIDER_AGENT_PRIVATE_KEY=0x_YOUR_PROVIDER_PRIVATE_KEY_HERE
