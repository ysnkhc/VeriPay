# VeriPay Customer Agent — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it contains your private key.

# ── Arc Testnet ──────────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002

# ── VeriPay backend ──────────────────────────────────────
VERIPAY_BACKEND_URL=http://localhost:3001

# ── Provider agent (must match provider config) ──────────
PROVIDER_AGENT_PORT=4101

# ── Customer agent config ────────────────────────────────
CUSTOMER_AGENT_ID=customer-payment-agent
CUSTOMER_AGENT_BUDGET_USDC=0.08

# ── Customer wallet (REQUIRED) ───────────────────────────
# Generate a new wallet:  node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# Fund it from Arc faucet: https://faucet.circle.com
CUSTOMER_AGENT_PRIVATE_KEY=0x_YOUR_CUSTOMER_PRIVATE_KEY_HERE
